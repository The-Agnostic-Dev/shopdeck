# Shopdeck configuration. Every value here is also the default, so the app
# runs without a .env file. Copy to .env and change what you need.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=5126
HOST=0.0.0.0
APP_URL=http://localhost:5126
LOG_LEVEL=info
# Vite dev server origin, allowed to call the API with cookies
CORS_ORIGIN=http://localhost:5326
# Built admin app served by the API, relative to api/
WEB_DIST_DIR=../web/dist
BUSINESS_TZ=Africa/Lagos

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://shopdeck@localhost:55426/shopdeck
DB_POOL_MAX=10
RUN_MIGRATIONS=true
# Wipes the database and loads demo data on every start. Never in production.
SEED_ON_START=true
SEED_RANDOM_SEED=20260

# --- Sessions -------------------------------------------------------------
SESSION_COOKIE=sd_session
SESSION_TTL_HOURS=12
SESSION_SECURE_COOKIE=false

# --- Background jobs ------------------------------------------------------
# inline: the API process runs the worker and cron. off: run `npm run worker -w api` separately.
RUN_WORKER=inline
WORKER_POLL_MS=500
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_MS=1000
CRON_ENABLED=true
LOW_STOCK_SWEEP_MINUTES=60
REFUND_SYNC_INTERVAL_SECONDS=60
REFUND_SYNC_STALE_MINUTES=2
SLOT_RELEASE_INTERVAL_MINUTES=15

# --- Payments: Payfront ---------------------------------------------------
# sandbox uses the fake in api/src/integrations/payfront/fake
PAYMENTS_PROVIDER=sandbox
PAYFRONT_BASE_URL=http://localhost:5126/_fake/payfront
PAYFRONT_SECRET_KEY=sk_test_ojafresh_local_4f1c9a
PAYFRONT_TIMEOUT_MS=8000
PAYFRONT_WEBHOOK_URL=http://localhost:5126/api/webhooks/payfront
FAKE_PAYFRONT_LATENCY_MS=400
FAKE_PAYFRONT_WEBHOOK_DELAY_MS=1200

# --- Email: Sendbox -------------------------------------------------------
MAIL_PROVIDER=sandbox
SENDBOX_BASE_URL=http://localhost:5126/_fake/sendbox
SENDBOX_API_KEY=SB.local.ojafresh
MAIL_FROM="Ọjà Fresh <hello@ojafresh.ng>"
OPS_ALERT_EMAIL=ops@ojafresh.ng

# --- SMS: Textng ----------------------------------------------------------
SMS_PROVIDER=sandbox
TEXTNG_BASE_URL=http://localhost:5126/_fake/textng
TEXTNG_API_KEY=TNG-local-ojafresh
SMS_SENDER_ID=OjaFresh

# --- Development helpers --------------------------------------------------
# /_dev/outbox lists every email and SMS the sandbox providers accepted
ENABLE_DEV_ROUTES=true
# Mounts the provider fakes under /_fake/*
ENABLE_FAKES=true

# --- Business rules -------------------------------------------------------
DELIVERY_FEE_KOBO=150000
LOW_STOCK_DEFAULT_THRESHOLD=10
ORDERS_PAGE_SIZE=25
CUSTOMERS_PAGE_SIZE=50
EXPORT_MAX_ROWS=20000
IMPORT_MAX_ROWS=2000

# --- Web (Vite) -----------------------------------------------------------
VITE_DEV_PORT=5326
VITE_API_PROXY_TARGET=http://localhost:5126
